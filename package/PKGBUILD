# Maintainer: Edward Diaz <edwardiaz.dev@gmail.com>

pkgname=google-antigravity-bin
pkgver=2.0.1
pkgrel=1
pkgdesc="Google Antigravity IDE (binary) - Precompiled official tar.gz repackaged for Arch - An agentic development platform from Google, evolving the IDE into the agent-first era."
arch=('x86_64')
url="https://antigravity.google/"
license=('custom')
provides=('antigravity' 'antigravity-ide' 'google-antigravity')
conflicts=('antigravity' 'antigravity-ide' 'google-antigravity')
depends=('alsa-lib'
    'dbus'
    'gnupg'
    'libnotify'
    'libsecret'
    'libxkbfile'
    'libxss'
    'nss'
    'gtk3'
    'xdg-utils'
    'ripgrep'
    'fd')
makedepends=('tar')
options=('!strip')
source=("https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/2.0.1-4861014005645312/linux-x64/Antigravity%20IDE.tar.gz"
    "antigravity-ide.desktop"
    "antigravity-ide-url-handler.desktop"
    "antigravity-ide.png")
sha256sums=('747163aa3a8afba4b316f97c40b4a75ca4736a59768a416cd1e881e73ec31ef9'
    'SKIP'
    'SKIP'
    'SKIP')

_appdir="Antigravity IDE"
_installdir="usr/share/antigravity-ide"

build() {
    # Ensure proper permissions for chrome-sandbox
    chmod 4755 "${_appdir}/chrome-sandbox"
}

package() {
    # Install application files
    install -dm755 "${pkgdir}/${_installdir}"
    cp -r --reflink=auto "${srcdir}/${_appdir}/." "${pkgdir}/${_installdir}/"

    # Install the CLI wrapper script (bin/antigravity-ide from upstream)
    install -dm755 "${pkgdir}/usr/bin"
    ln -s "/usr/share/antigravity-ide/bin/antigravity-ide" "${pkgdir}/usr/bin/antigravity-ide"

    # Backward-compatible symlinks
    ln -s /usr/bin/antigravity-ide "${pkgdir}/usr/bin/antigravity"
    ln -s /usr/bin/antigravity-ide "${pkgdir}/usr/bin/google-antigravity"

    # Install .desktop files
    install -Dm644 "${srcdir}/antigravity-ide.desktop" "${pkgdir}/usr/share/applications/antigravity-ide.desktop"
    install -Dm644 "${srcdir}/antigravity-ide-url-handler.desktop" "${pkgdir}/usr/share/applications/antigravity-ide-url-handler.desktop"

    # Install icon
    install -Dm644 "${srcdir}/antigravity-ide.png" "${pkgdir}/usr/share/pixmaps/antigravity-ide.png"
}
